<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by the Mac App Store; the keys below re-grant what Stego needs. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Writing to the file the export save panel hands back. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Sync account. Without it the sandbox blocks every request silently. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Legacy iCloud container, kept so older deck files stay reachable. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.jonlee.stego</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.jonlee.stego</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>

	<key>com.apple.application-identifier</key>
	<string>TTM9BN6M53.com.jonlee.stego</string>
	<key>com.apple.developer.team-identifier</key>
	<string>TTM9BN6M53</string>
</dict>
</plist>
