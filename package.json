{
  "name": "stego",
  "private": true,
  "version": "1.0.0",
  "productName": "Stego",
  "description": "Stegosaurus-themed flashcard and testing app for macOS and iOS",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "mac": "npm run build && electron .",
    "mac:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env STEGO_DEV_URL=http://localhost:5173 electron .\"",
    "mac:dist": "npm run build && electron-builder --mac",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "ios:device": "npm run ios:sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.2",
    "@capacitor/filesystem": "^7.1.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.jonlee.stego",
    "productName": "Stego",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ]
    },
    "dmg": {
      "title": "Stego"
    }
  }
}
